   "source": [
    "kmeans_recipe <- recipe(~.,data = clean_beer)|>\n",
    "                    step_scale(all_predictors())|>\n",
    "                    step_center(all_predictors())\n",
    "\n",
    "kmeans_spec <- k_means(num_clusters = 2)|>\n",
    "                set_engine(\"stats\")\n",
    "\n",
    "kmeans_fit <- workflow()|>\n",
    "            add_recipe(kmeans_recipe)|>\n",
    "            add_model(kmeans_spec)|>\n",
    "            fit(clean_beer)\n",
    "\n",
    "labelled_beer <- augment(kmeans_fit, clean_beer) #add the cluster assignment for each point to the clean_beer data frame\n",
    "\n",
    "cluster_plot <- ggplot(labelled_beer, aes(x=ibu,y=abv,color=.pred_cluster))+\n",
    "                        geom_point()+\n",
    "                        labs(x=\"International Bitterness Unit\", y=\"Alcohol by volume\",color = \"Cluster\")+\n",
    "                        theme(text=element_text(size=20))\n",
    "cluster_plot"
   ]
