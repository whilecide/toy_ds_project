   "source": [
    "options(repr.plot.height = 5, repr.plot.width = 6)"
   ]
  },
  {
   "cell_type": "raw",
   "id": "e1df3820-299f-4ac9-8587-e44ae47f74d6",
   "metadata": {},
   "source": [
    "co2_scatter <- ggplot(co2_df, aes(x = date_measured, y = ppm, color = category, shape = category)) +\n",
    "  geom_point(alpha = 0.4) +\n",
    "  geom_line() +\n",
    "  xlim(c(date(\"1990-01-01\"), date(\"1993-12-01\"))) +  #limit the range of x-axis\n",
    "  labs(x = \"date measured\", y = \"ppm\", color = \"category\", shape = \"category\") +\n",
    "  ggtitle(\"data measured versus ppm\") +\n",
    "  theme(text = element_text(size = 12)\n",
    "  legend.position = \"top\", #move the legend\n",
    "  legend.direction = \"vertical\") + #diretion of legend\n",
    "  scale_x_log10(labels = label_comma) + #对数缩放Log scaling, when some data is too small or too large)\n",
    "  scale_y_log10(labels = label_comma) +   #label_comma means somethinglike 1,000\n",
    "  scale_color_brewer(palette = \"Set2\")"
   ]
  },
  {
   "cell_type": "raw",
   "id": "c6a00243-4dbf-40ab-9fb2-650a90ba4e6b",
   "metadata": {},
