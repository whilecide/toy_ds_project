   "source": [
    "lang_mother_tidy <- pivot_longer(lang_wide,\n",
    "  cols = Toronto:Edmonton,\n",
    "  names_to = \"region\",\n",
    "  values_to = \"mother_tongue\"\n",
    ")"
   ]
  },
  {
   "cell_type": "raw",
   "id": "abf4da34-f89d-4459-a610-79b5f4625e94",
   "metadata": {},
   "source": [
    "lang_home_tidy <- pivot_wider(lang_long,\n",
    "  names_from = type,\n",
    "  values_from = count\n",
    ")"
   ]
  },
  {
   "cell_type": "raw",
   "id": "d975cf20-aa86-4491-a7b3-ce6f81cb65c4",
   "metadata": {},
   "source": [
    "lang_mother_tidy <- pivot_longer(lang_wide,\n",
    "  cols = Toronto:Edmonton,\n",
    "  names_to = \"region\",\n",
    "  values_to = \"mother_tongue\"\n",
    ")\n",
    "\n",
    "tidy_lang <- separate(lang_messy_longer,\n",
    "  col = value,\n",
    "  into = c(\"most_at_home\", \"most_at_work\"),\n",
    "  sep = \"/\"\n",
    ") #when 2 values for one lattice"
   ]
  },
  {
   "cell_type": "raw",
   "id": "0408b3b3-aa93-4d8f-b25f-2af7c07b6bfe",
   "metadata": {},
   "source": [
    "selected_columns <- select(tidy_lang,\n",
    "                           language,\n",
    "                           region,\n",
    "                           most_at_home,\n",
    "                           most_at_work)\n",
    "\n",
    "selected_columns <- select(-tidy_lang)\n",
    "\n",
    "column_range <- select(tidy_lang, language:most_at_work)\n",
    "\n",
    "select(tidy_lang, starts_with(\"most\"))\n",
    "\n",
    "select(tidy_lang, contains(\"_\"))"
   ]
  },
  {
   "cell_type": "raw",
   "id": "f081d7c5-0843-4693-a9ad-0ad514f2f1d6",
   "metadata": {},
   "source": [
    "official_langs <- filter(tidy_lang, category == \"Official languages\")\n",
    "\n",
    "official_langs<-filter(tidy_lang, category != \"Official languages\")\n",
    "\n",
    "official_langs <- filter(official_langs, region == \"Montréal\", language == \"French\")\n",
    "\n",
    "filter(official_langs, region == \"Calgary\" | region == \"Edmonton\") #satisfy a or b\n",
    "\n",
    "city_names <- c(\"Toronto\", \"Montréal\", \"Vancouver\", \"Calgary\", \"Edmonton\")\n",
    "five_cities <- filter(region_data,\n",
    "                      region %in% city_names)\n",
    "\n",
    "filter(official_langs, most_at_home > 2669195) #greater than this value"
   ]
  },
  {
   "cell_type": "raw",
   "id": "0b089d48-7aa9-4e95-afb8-54d84f9d2ef2",
   "metadata": {},
   "source": [
    "official_langs_numeric <- mutate(official_langs_chr,\n",
    "  most_at_home = as.numeric(most_at_home),\n",
    "  most_at_work = as.numeric(most_at_work)\n",
    ")\n",
    "\n",
    "english_langs <- mutate(english_langs,\n",
    "                         most_at_home_proportion = most_at_home / city_pops)\n",
    "\n",
    "region_lang |>\n",
    "  mutate(across(mother_tongue:lang_known, as.integer)) #change the type of conlumns\n",
    "\n",
    "region_lang |>\n",
    "  select(mother_tongue:lang_known) |>\n",
    "  rowwise() |>\n",
    "  mutate(maximum = max(c(mother_tongue,\n",
    "                         most_at_home,\n",
    "                         most_at_work,\n",
    "                         lang_known))) #find the maxium value of each row across the conlumns (summarize is just for one observation (conlumn), while mutate is not but across all selected conlumns)"
   ]
  },
  {
   "cell_type": "raw",
   "id": "7798802a-c2de-4e80-8722-be3115d741d5",
   "metadata": {},
   "source": [
    "summarize(region_lang_na,\n",
    "          min_most_at_home = min(most_at_home, na.rm = TRUE),\n",
    "          max_most_at_home = max(most_at_home, na.rm = TRUE))\n",
    "\n",
    " summarize(\n",
    "    count = n(),\n",
    "    percentage = n() / num_obs * 100)"
   ]
  },
  {
   "cell_type": "raw",
   "id": "c7518030-257e-4bf3-b67a-2025a5299784",
   "metadata": {},
   "source": [
    "group_by(region_lang, region) |>\n",
    "  summarize(\n",
    "    min_most_at_home = min(most_at_home),\n",
    "    max_most_at_home = max(most_at_home)\n",
    "    )"
   ]
  },
  {
   "cell_type": "raw",
   "id": "1be94057-4712-44c6-a060-6ec4cceea1fe",
   "metadata": {},
   "source": [
    "region_lang |>\n",
    "  select(mother_tongue:lang_known) |>\n",
    "  map(max) \n",
    "#the maximum value of the selected conlumns.\n",
    "#print as a list\n",
    "\n",
    "region_lang |>\n",
    "  select(mother_tongue:lang_known) |>\n",
    "  map_dfr(max)\n",
    "#print as a table"
   ]
  },
  {
