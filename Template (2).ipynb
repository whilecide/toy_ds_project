  {
   "cell_type": "markdown",
   "id": "1c88a2c9-0d15-4639-aad5-01c3c0a6606f",
   "metadata": {},
   "source": [
    "## 4. Classification"
   ]
  },
  {
   "cell_type": "raw",
   "id": "b77065a5-5c8f-465d-8245-13e34d16329f",
   "metadata": {},
   "source": [
    "cancer <- cancer |>\n",
    "  mutate(Class = as_factor(Class)) |> #make the class as a category\n",
    "  mutate(Class = fct_recode(Class, \"Malignant\" = \"M\", \"Benign\" = \"B\")) #change the class' name\n",
    "glimpse(cancer) #print table horizontally (personal understanding), when we have plenty of conlumns, we will use that\n",
    "\n",
    "cancer |>\n",
    "  distinct(Class) #show the true name of each class"
   ]
  },
  {
   "cell_type": "raw",
   "id": "cef139fa-a705-4d74-8aa8-38b87e466135",
   "metadata": {},
   "source": [
    "mutate(dist_from_new = sqrt((Perimeter - new_obs_Perimeter)^2 +\n",
    "                              (Concavity - new_obs_Concavity)^2)) \n",
    "#use the formula to calculate the distance between data and new variable\n",
    "\n",
    "fruit_dist <- fruit_data |>\n",
    "            slice(1,2) |> #choose the data in table\n",
    "            select(mass, width) |> #compare the conlumns\n",
    "            dist()"
   ]
  },
  {
   "cell_type": "raw",
   "id": "b9915f00-375d-4884-b3df-f95ba70f413e",
   "metadata": {},
   "source": [
    "knn_spec <- nearest_neighbor(weight_func = \"rectangular\", neighbors = 5) |>\n",
    "                set_engine(\"kknn\") |>\n",
    "                set_mode(\"classification\")\n",
    "\n",
    "recipe <- recipe(fruit_name ~ mass + color_score, data = data) |> #Defines a recipe for preprocessing the data\n",
    "                    step_scale(all_predictors()) |>  #Adds a step to scale all predictors\n",
    "                    step_center(all_predictors()) |> #Ensures that the predictors have a mean of zero\n",
    "                    prep() |> #Prepares the recipe by estimating the required parameters\n",
    "                    step_upsample(Class, over_ratio = 1, skip = FALSE) |> #Balances the dataset\n",
    "                    step_impute_mean(all_predictors()) |> #Handles missing data by providing a sensible default value\n",
    "                    bake(fruit_data) #Applies the prepared preprocessing steps to new data\n",
    "\n",
    "fit <- workflow() |>\n",
    "                add_recipe(recipe)|>\n",
    "                add_model(knn_spec)|>\n",
    "                fit(data = variable)\n",
    "\n",
    "new_data <- tibble(conlumn_1 = 150, conlumn_2 = 0.73)\n",
    "fruit_predicted <- predict(fit, new_data)"
   ]
  },
  {
   "cell_type": "raw",
   "id": "c920602e-9d33-495e-bc5f-00f2625b93e5",
   "metadata": {},
   "source": [
    "set.seed(1234)\n",
    "random_number <- sample(0:9, 10, replace = TRUE)\n",
    "#choose 10 number from 0 to 9"
   ]
  },
  {
   "cell_type": "raw",
   "id": "10694281-0c3e-4ed8-a86e-934cd7170ca7",
   "metadata": {},
   "source": [
    "cancer_split <- initial_split(cancer, prop = 0.75, strata = Class)\n",
    "cancer_train <- training(cancer_split)\n",
    "cancer_test <- testing(cancer_split)"
   ]
  },
  {
   "cell_type": "raw",
   "id": "af577b85-2a18-4c45-b5ca-2edcacdc817d",
   "metadata": {},
   "source": [
    "cancer_test_predictions <- predict(knn_fit, cancer_test) |>\n",
    "  bind_cols(cancer_test) #bind it to another table\n",
    "\n",
    "cancer_test_predictions |>\n",
    "  metrics(truth = Class, estimate = .pred_class) |>\n",
    "  filter(.metric == \"accuracy\")\n",
    "#test the accuracy of the given k value"
   ]
  },
  {
   "cell_type": "raw",
   "id": "bb30791c-5211-41b2-a3f3-626d0ef3cef5",
   "metadata": {},
   "source": [
    "cross_recipe <- recipe(y ~ ., data = training_set) |>\n",
    "                step_scale(all_predictors()) |>\n",
    "                step_center(all_predictors())\n",
    "\n",
    "knn_tune <- nearest_neighbor(weight_func= \"rectangular\", neighbors = tune())|>\n",
    "            set_engine(\"kknn\")|>\n",
    "            set_mode(\"classification\")\n",
    "\n",
    "cross_vfold <- vfold_cv(training_set, v = 5, strata = y)\n",
    "\n",
    "k_vals <- tibble(neighbors = seq(from = 2, to = 6, by = 1))\n",
    "\n",
    "knn_results <- workflow() |>\n",
    "                add_recipe(cross_recipe) |>\n",
    "                add_model(knn_tune) |>\n",
    "                tune_grid(resamples = cross_vfold, grid = k_vals)|>\n",
    "                collect_metrics()\n",
    "\n",
    "accuracies <- knn_results |>\n",
    "            filter(.metric == \"accuracy\")\n",
    "\n",
    "cross_val_plot <- ggplot(accuracies, aes(x = neighbors, y = mean)) +\n",
    "                            geom_point() +\n",
    "                            geom_line() +\n",
    "                            labs(x = \"Neighbors\", y = \"Accuracy Estimate\") \n",
    "                            \n",
    "cross_val_plot\n",
    "\n",
    "best_k <- accuracies |>\n",
    "        arrange(desc(mean)) |>\n",
    "        head(1) |>\n",
    "        pull(neighbors)\n",
    "best_k"
